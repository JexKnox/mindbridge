# mindbridge 依赖服务(PostgreSQL + Qdrant)环境变量
# ----------------------------------------------------------
# 用法: cp deploy/.env.example deploy/.env
# docker compose 会自动读取与 docker-compose.yml 同目录下的 .env。
# (deploy/.env 已在 .gitignore 的 .env 规则下被忽略,不会提交凭证。)
#
# 以下默认值与 configs/config.example.yaml 完全对齐:
#   postgres.dsn = postgres://mindbridge:mindbridge@localhost:5432/mindbridge?sslmode=disable
#   qdrant.host  = localhost
#   qdrant.port  = 6333
# 若修改此处,务必同步修改 configs/config.yaml,否则应用无法连接。

# ---- PostgreSQL ----
POSTGRES_USER=mindbridge
POSTGRES_PASSWORD=mindbridge
POSTGRES_DB=mindbridge

# ---- Qdrant ----
# 本地单容器开发环境,默认不开认证(与 config.example.yaml 中 qdrant.api_key 留空一致)。
# 切勿在此设置 QDRANT__SERVICE__API_KEY;如需开启认证,需同时在 config.yaml 配置 api_key。
