# mindbridge 环境变量(供 docker compose 全栈启动)
# ----------------------------------------------------------
# 用法: cp deploy/.env.example deploy/.env
# docker compose 会自动读取与 docker-compose.yml 同目录下的 .env。
# (deploy/.env 已在 .gitignore 的 .env 规则下被忽略,不会提交凭证。)
#
# 全栈模式:本文件经 configs/config.docker.yaml 的 ${VAR} 占位注入应用配置。
# 仅依赖模式:POSTGRES_* 默认值与 configs/config.example.yaml 对齐,
#   应用本地 make run 时连 localhost:5432 / localhost:6333。

# ---- PostgreSQL ----
POSTGRES_USER=mindbridge
POSTGRES_PASSWORD=mindbridge
POSTGRES_DB=mindbridge

# ---- Qdrant ----
# 本地单容器开发环境,默认不开认证(与 config.example.yaml 中 qdrant.api_key 留空一致)。
# 切勿在此设置 QDRANT__SERVICE__API_KEY;如需开启认证,需同时在 config 配置 api_key。

# ---- LLM 模型(全栈模式必填,否则 chat/embedding 调用会失败)----
# OpenAI 兼容端点:火山 Ark / DeepSeek / 通义 / 智谱 / Ollama 等均可。
# chat 与 embedding 可用同一 Provider,也可分开。
CHAT_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
CHAT_API_KEY=your-chat-api-key
CHAT_MODEL=your-chat-model-name

EMB_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
EMB_API_KEY=your-embedding-api-key
EMB_MODEL=your-embedding-model-name
